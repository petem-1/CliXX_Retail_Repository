pipeline {
    agent any

    environment {
        VERSION = "1.0.${BUILD_NUMBER}"
        // Hardcoded Java 11 path — SonarScanner 4.7's JS analyzer breaks under Java 21's module restrictions
        JAVA_HOME = '/usr/lib/jvm/java-11-amazon-corretto.x86_64'
        PATH = "${env.JAVA_HOME}/bin:${getSonarPath()}:${env.PATH}"
    }

    stages {
        stage ('Sonarcube Scan') {
            steps {
                script {
                    scannerHome = tool 'sonarqube'
                }
                sh "echo Scanner home is: ${scannerHome}"
                withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                    withSonarQubeEnv('SonarQubeScanner') {
                        sh "${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=Clixx-App-Pete \
                        -Dsonar.login=${SONAR_TOKEN} \
                        -Dsonar.qualitygate.wait=true \
                        -Dsonar.qualitygate.timeout=600"
                    }
                }
            }
        }

        stage ('Build Docker Image') {
            steps {
                sh "docker build . -t clixx-image:$VERSION"
            }
        }

        stage ('Starting Docker Image') {
            steps {
                sh '''
                if ( docker ps|grep clixx-cont ) then
                    echo "Docker image exists, killing it"
                    docker stop clixx-cont
                    docker rm clixx-cont
                    docker run --name clixx-cont -p 80:80 -d clixx-image:$VERSION
                else
                    docker run --name clixx-cont -p 80:80 -d clixx-image:$VERSION
                fi
                '''
            }
        }
    }
}

def getSonarPath(){
    def SonarHome = tool name: 'sonarqube', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
    return SonarHome
}
